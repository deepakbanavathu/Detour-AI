# copy to .env; docker compose reads it automatically
DB_PASSWORD=change-me-db
ADMIN_TOKEN=change-me-admin
# optional: OpenAI-compatible server for the IR stage (vLLM / llama.cpp on the home box); empty = regex only
LLM_BASE_URL=
LLM_MODEL=qwen2.5-7b-instruct-q4
# ingestion keys; a source with no key is skipped and shows "needs a key" in /v1/sources
X_BEARER_TOKEN=
TOMTOM_KEY=

# ---- commuter channel (all optional; with none set the channel code runs and sends nothing)
# set real random values before any real subscriber signs up: python -c "import secrets;print(secrets.token_urlsafe(32))"
PII_KEY=
PII_PEPPER=
# public https address of this API (Cloudflare Tunnel hostname); needed for webhooks and short links
PUBLIC_BASE_URL=
# WhatsApp Cloud API: Meta dashboard > WhatsApp > API setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_CLEARED_TEMPLATE=
# Telegram: token from @BotFather; the secret is any random string you also pass to setWebhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# SMS fallback: empty = off, log = record only, msg91 = send (needs DLT-approved template)
SMS_PROVIDER=
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
